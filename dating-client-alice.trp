(* Placeholder for the dating-client. Note that in order to communicate 
   with your server you will need to create the corresponding trustmap *)
   
import lists
let 
   fun sendProfile () = 
      let val profile = (`{alice}`, "Alice" raisedTo `{alice}`, 2000 raisedTo `{alice}`, true raisedTo `{alice}`, [] raisedTo `{alice}`)
         fun agent p = 
            let 
               val (lev, name, year, gender, interests) = p
               val (_, bob_name, bob_year, bob_gender, bob_interesets) = profile
            in 
               if gender then 
                  (false, ())
               else 
                  (
                     true, 
                     (lev, declassify(bob_name, authority, lev), declassify(bob_year, authority, lev), declassify(bob_gender, authority, lev), declassify(bob_interesets, authority, lev))
                  )
            end
         val pid = node ( self ())
      in 
         send ( whereis ("QmeUUFFNURHqbAFcwvULoxc52ywxx3j85QNdMkCiibJTFJ", "datingServer"), ("NEWPROFILE", (profile, agent, pid)));
         print ("NEWPROFILE", (profile, agent, pid))
      end

   fun receiveResponse () = 
      receive [hn (default) => (* print default; *) receiveResponse() ]

   fun main () = 
      let val thisNode = node ( self ())
          val _ = printString ("Running node with identifier: " ^ thisNode)
          val _ = register ("client", spawn receiveResponse, authority)
      in
         sendProfile ()
      end
in 
   main ()
end